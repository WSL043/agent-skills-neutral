{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills-neutral.local/schemas/execution-attribution.schema.json",
  "title": "Agent Execution Attribution Receipt",
  "$comment": "Portable shape and state-local constraints. Trust decisions must also run execution_attribution.py validate for cross-field relational invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "receipt_id",
    "recorded_at",
    "producer",
    "session",
    "runtime",
    "serving",
    "activation",
    "privacy",
    "integrity"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "serving": {
            "properties": {"status": {"const": "verified"}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "serving": {
            "properties": {
              "evidence_strength": {"const": "direct"},
              "bundle": {"$ref": "#/$defs/bundleIdentity"},
              "surfaces": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "name": {"const": "AGENTS.md"},
                    "status": {"const": "observed_prompt_visible"},
                    "evidence": {"const": "actual_session_agents_exact_match"}
                  },
                  "required": ["name", "status", "evidence"]
                },
                "minContains": 1
              },
              "evidence": {
                "contains": {"const": "world_state_assignments_match"},
                "minContains": 1,
                "not": {
                  "contains": {
                    "enum": ["trace_incomplete", "trace_structure_unsupported"]
                  }
                }
              }
            }
          },
          "session": {
            "properties": {
              "trace": {
                "properties": {
                  "status": {"const": "linked"},
                  "pointer": {"$ref": "#/$defs/digest"},
                  "content_digest": {"$ref": "#/$defs/digest"},
                  "bytes": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activation": {
            "properties": {"status": {"const": "observed_skill_content"}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {
              "evidence_scope": {
                "enum": ["complete_trace_snapshot", "partial_trace_snapshot"]
              },
              "observed_skills": {"minItems": 1}
            }
          },
          "serving": {
            "properties": {"bundle": {"$ref": "#/$defs/bundleIdentity"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activation": {
            "properties": {"status": {"enum": ["none_observed", "unknown"]}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {"observed_skills": {"maxItems": 0}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activation": {
            "properties": {"status": {"const": "none_observed"}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {"evidence_scope": {"const": "complete_trace_snapshot"}}
          },
          "session": {
            "properties": {
              "trace": {
                "properties": {"status": {"const": "linked"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activation": {
            "properties": {
              "status": {"enum": ["observed_skill_content", "none_observed"]}
            },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "serving": {
            "properties": {"status": {"const": "verified"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "serving": {
            "properties": {"status": {"const": "mismatch"}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "serving": {
            "properties": {
              "evidence": {
                "contains": {"$ref": "#/$defs/mismatchEvidenceCode"},
                "minContains": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "serving": {
            "properties": {"status": {"enum": ["verified", "unknown"]}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "serving": {
            "properties": {
              "evidence": {
                "not": {"contains": {"$ref": "#/$defs/mismatchEvidenceCode"}}
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "execution-attribution"},
    "receipt_id": {"$ref": "#/$defs/opaqueId"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "agent-skills-neutral/execution-attribution"},
        "version": {"const": 1}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run_id", "source", "start_source", "cwd_digest", "trace"],
      "properties": {
        "id": {"$ref": "#/$defs/nullableOpaqueId"},
        "run_id": {"$ref": "#/$defs/opaqueId"},
        "source": {"$ref": "#/$defs/nullableSafeToken"},
        "start_source": {"$ref": "#/$defs/nullableSafeToken"},
        "cwd_digest": {"$ref": "#/$defs/nullableDigest"},
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "pointer", "content_digest", "bytes"],
          "properties": {
            "status": {"enum": ["unknown", "linked", "snapshot"]},
            "pointer": {"$ref": "#/$defs/nullableDigest"},
            "content_digest": {"$ref": "#/$defs/nullableDigest"},
            "bytes": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "name", "version", "model"],
      "properties": {
        "vendor": {"$ref": "#/$defs/safeToken"},
        "name": {"$ref": "#/$defs/safeToken"},
        "version": {"$ref": "#/$defs/nullableSafeToken"},
        "model": {"$ref": "#/$defs/nullableSafeToken"}
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_strength", "bundle", "preflight", "surfaces", "evidence"],
      "properties": {
        "status": {"enum": ["verified", "unknown", "mismatch"]},
        "evidence_strength": {"enum": ["direct", "strong", "limited", "unknown"]},
        "bundle": {"anyOf": [{"$ref": "#/$defs/bundleIdentity"}, {"type": "null"}]},
        "preflight": {
          "anyOf": [
            {"$ref": "#/$defs/preflightEvidence"},
            {"type": "null"}
          ]
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "digest", "evidence"],
            "properties": {
              "name": {"enum": ["AGENTS.md", "runtime-catalog.json", "skills/*/SKILL.md"]},
              "status": {
                "enum": [
                  "observed_prompt_visible",
                  "preflight_prompt_visible",
                  "artifact_verified",
                  "available_on_demand",
                  "unknown"
                ]
              },
              "digest": {"$ref": "#/$defs/nullableDigest"},
              "evidence": {"$ref": "#/$defs/surfaceEvidenceCode"}
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/servingEvidenceCode"},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_scope", "observed_skills", "adoption_claim"],
      "properties": {
        "status": {"enum": ["observed_skill_content", "none_observed", "unknown"]},
        "evidence_scope": {
          "enum": ["complete_trace_snapshot", "partial_trace_snapshot", "none"]
        },
        "observed_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "evidence_kind",
              "trace_line",
              "tool",
              "call_id_digest",
              "successful_output",
              "adoption"
            ],
            "properties": {
              "name": {"$ref": "#/$defs/skillName"},
              "evidence_kind": {"const": "successful_tool_content_match"},
              "trace_line": {"type": "integer", "minimum": 1},
              "tool": {"$ref": "#/$defs/safeToken"},
              "call_id_digest": {"$ref": "#/$defs/digest"},
              "successful_output": {"const": true},
              "adoption": {"const": "unknown"}
            }
          }
        },
        "adoption_claim": {"const": "unknown"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompts_copied",
        "responses_copied",
        "source_content_copied",
        "tool_payloads_copied",
        "trace_content_copied",
        "absolute_paths_stored"
      ],
      "properties": {
        "prompts_copied": {"const": false},
        "responses_copied": {"const": false},
        "source_content_copied": {"const": false},
        "tool_payloads_copied": {"const": false},
        "trace_content_copied": {"const": false},
        "absolute_paths_stored": {"const": false}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "receipt_digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "surfaceEvidenceCode": {
      "enum": [
        "manifest_agents_artifact_verified",
        "manifest_runtime_catalog_available",
        "manifest_skill_bodies_available",
        "preflight_agents_prompt_visible",
        "preflight_runtime_catalog_prompt_visible",
        "actual_session_assignment_pending",
        "actual_session_agents_exact_match"
      ]
    },
    "skillName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mismatchEvidenceCode": {
      "enum": [
        "bundle_verification_failed",
        "preflight_bundle_mismatch",
        "session_cwd_bundle_path_mismatch",
        "bundle_reverification_failed",
        "preflight_after_session_start",
        "world_state_assignment_mismatch",
        "resume_bundle_mismatch"
      ]
    },
    "servingEvidenceCode": {
      "enum": [
        "legacy_trace_without_contemporaneous_bundle",
        "bundle_verification_failed",
        "bundle_at_session_cwd_assignment_pending",
        "preflight_matches_bundle",
        "preflight_bundle_mismatch",
        "session_cwd_bundle_path_mismatch",
        "bundle_reverification_failed",
        "bundle_path_omitted",
        "preflight_after_session_start",
        "world_state_agents_invalid",
        "world_state_assignment_mismatch",
        "trace_structure_unsupported",
        "world_state_assignments_match",
        "trace_incomplete",
        "explicit_trace_link_without_sessionstart",
        "resume_bundle_mismatch",
        "resume_requires_reverification",
        "sessionend_trace_missing"
      ]
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "opaqueId": {
      "anyOf": [
        {"type": "string", "format": "uuid"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "safeToken": {
      "type": "string",
      "pattern": "^(?:sha256:[0-9a-f]{64}|(?!\\.{1,2}$)[A-Za-z0-9][A-Za-z0-9._+-]{0,199})$"
    },
    "nullableSafeToken": {
      "anyOf": [{"$ref": "#/$defs/safeToken"}, {"type": "null"}]
    },
    "repositoryIdentity": {
      "type": "string",
      "pattern": "^(?!\\.\\.?/)(?![^/]+/\\.\\.?$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "nullableOpaqueId": {
      "anyOf": [{"$ref": "#/$defs/opaqueId"}, {"type": "null"}]
    },
    "nullableDigest": {
      "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "preflightEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recorded_at", "record_digest"],
      "properties": {
        "status": {"enum": ["matched", "mismatch"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "record_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "bundleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_commit",
        "source_dirty",
        "manifest_digest",
        "catalog_digest",
        "runtime_catalog_digest",
        "agents_digest",
        "path_digest",
        "skill_digests"
      ],
      "properties": {
        "source_repository": {"$ref": "#/$defs/repositoryIdentity"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_dirty": {"type": "boolean"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "catalog_digest": {"$ref": "#/$defs/digest"},
        "runtime_catalog_digest": {"$ref": "#/$defs/digest"},
        "agents_digest": {"$ref": "#/$defs/digest"},
        "path_digest": {"$ref": "#/$defs/digest"},
        "skill_digests": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/skillName"},
          "additionalProperties": {"$ref": "#/$defs/digest"}
        }
      }
    }
  }
}
