{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Skills Neutral Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "library",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "library": {
      "const": "agent-skills-neutral"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "category",
          "reference_level",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "path": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "reference_level": {
            "enum": [
              "S",
              "A",
              "B"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
